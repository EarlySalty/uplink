[Unit]
Description=Uplink-Zertifikat aus Caddy nach Infisical übernehmen
After=network.target caddy.service infisical-bridge.service
Requires=infisical-bridge.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/uplink/current/bin/uplink-tls-provider --config /etc/uplink/tls-provider.toml
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/nathanael/Documents/Infisical/service_token.json
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=96M
TasksMax=32
Nice=10
CPUQuota=10%
LimitCORE=0

# Kein Environment, keine LoadCredential-Kopie und kein beschreibbarer Keypfad.
# Der Prozess liest ausschließlich die drei expliziten Quelldateien aus TOML.
StandardOutput=journal
StandardError=journal
